{
  "expo": {
    "name": "Shoppa",
    "slug": "shoppa-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "shoppa",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.shoppa.mobile",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "app.shoppa.mobile"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Shoppa needs access to your photos so you can pick a profile picture.",
          "cameraPermission": "Shoppa needs camera access so you can snap a photo for your profile or post item."
        }
      ],
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
