{
  "expo": {
    "name": "Shoppa",
    "slug": "shoppa-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "shoppa",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.shoppa.mobile"
    },
    "android": {
      "package": "app.shoppa.mobile"
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
